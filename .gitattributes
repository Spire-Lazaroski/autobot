# generated by web/scripts/gen-brand.mjs with LF; keep it byte-identical so 'npm run brand -- --check' passes on Windows
autobot/assets/brand.json text eol=lf
autobot/assets/brand.css text eol=lf
web/src/brand.css text eol=lf
# Linux server files must keep LF line endings (bash and systemd reject CRLF)
*.sh text eol=lf
deploy/linux/* text eol=lf
